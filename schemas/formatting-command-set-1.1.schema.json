{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://docxtool.local/schemas/formatting-command-set-1.1.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","request_id","service_version","profile_id","profile_version","commands","warnings"],
  "properties":{"schema_version":{"const":"1.1"},"request_id":{"type":"string","pattern":"^[A-Za-z0-9-]{16,64}$"},"service_version":{"type":"string"},"profile_id":{"type":"string"},"profile_version":{"type":"string"},"warnings":{"type":"array","items":{"type":"string"}},"commands":{"type":"array","items":{"$ref":"#/$defs/command"}}},
  "$defs":{"target":{"type":"object","additionalProperties":false,"required":["target_id","source_paragraph_index","text_sha256"],"properties":{"target_id":{"type":"string"},"source_paragraph_index":{"type":"integer","minimum":0},"text_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},"command":{"type":"object","additionalProperties":false,"required":["command_id","kind","target","arguments","required_capability","on_unsupported"],"properties":{"command_id":{"type":"string"},"kind":{"enum":["paragraph.set_font","paragraph.set_alignment","paragraph.set_indent","paragraph.set_spacing","section.set_page_setup"]},"target":{"$ref":"#/$defs/target"},"arguments":{"type":"object"},"required_capability":{"type":"string"},"on_unsupported":{"enum":["skip","fail"]}}}}
}
