{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://docxtool.local/schemas/formatting-command-set-1.1.schema.json",
  "title":"FormattingCommandSet 1.1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","request_id","service_version","profile_id","profile_version","commands","warnings"],
  "properties":{"schema_version":{"const":"1.1"},"request_id":{"type":"string","pattern":"^[A-Za-z0-9-]{16,64}$"},"service_version":{"type":"string"},"profile_id":{"type":"string"},"profile_version":{"type":"string"},"warnings":{"type":"array","items":{"type":"string"}},"commands":{"type":"array","items":{"oneOf":[{"$ref":"#/$defs/setFont"},{"$ref":"#/$defs/setAlignment"},{"$ref":"#/$defs/setIndent"},{"$ref":"#/$defs/setSpacing"},{"$ref":"#/$defs/setPageSetup"}]}}},
  "$defs":{
    "target":{"type":"object","additionalProperties":false,"required":["target_id","source_paragraph_index","text_sha256","text_length","occurrence_index"],"properties":{"target_id":{"type":"string","minLength":1,"maxLength":160},"source_paragraph_index":{"type":"integer","minimum":0},"text_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"text_length":{"type":"integer","minimum":0},"occurrence_index":{"type":"integer","minimum":0}}},
    "base":{"type":"object","additionalProperties":false,"required":["command_id","kind","target","arguments","required_capability","on_unsupported"],"properties":{"command_id":{"type":"string","pattern":"^cmd-[0-9]{6}$"},"kind":{"type":"string"},"target":{"$ref":"#/$defs/target"},"arguments":{"type":"object"},"required_capability":{"type":"string"},"on_unsupported":{"enum":["skip","fail"]}}},
    "setFont":{"allOf":[{"$ref":"#/$defs/base"},{"properties":{"kind":{"const":"paragraph.set_font"},"required_capability":{"const":"paragraph.font"},"arguments":{"type":"object","additionalProperties":false,"required":["east_asia_font_name","latin_font_name","font_size_pt","bold"],"properties":{"east_asia_font_name":{"type":"string","minLength":1},"latin_font_name":{"type":"string","minLength":1},"font_size_pt":{"type":"number","minimum":5,"maximum":72},"bold":{"type":"boolean"}}}}}]},
    "setAlignment":{"allOf":[{"$ref":"#/$defs/base"},{"properties":{"kind":{"const":"paragraph.set_alignment"},"required_capability":{"const":"paragraph.alignment"},"arguments":{"type":"object","additionalProperties":false,"required":["alignment"],"properties":{"alignment":{"enum":["left","center","right","justify","distributed"]}}}}}]},
    "setIndent":{"allOf":[{"$ref":"#/$defs/base"},{"properties":{"kind":{"const":"paragraph.set_indent"},"required_capability":{"const":"paragraph.indent"},"arguments":{"type":"object","additionalProperties":false,"required":["first_line_indent_chars","left_indent_chars","right_indent_chars"],"properties":{"first_line_indent_chars":{"type":"number","minimum":-10,"maximum":10},"left_indent_chars":{"type":"number","minimum":-10,"maximum":10},"right_indent_chars":{"type":"number","minimum":-10,"maximum":10}}}}}]},
    "setSpacing":{"allOf":[{"$ref":"#/$defs/base"},{"properties":{"kind":{"const":"paragraph.set_spacing"},"required_capability":{"const":"paragraph.spacing"},"arguments":{"type":"object","additionalProperties":false,"required":["space_before_lines","space_after_lines","line_spacing_rule","line_spacing_pt","page_break_before","outline_level"],"properties":{"space_before_lines":{"type":"number","minimum":0,"maximum":10},"space_after_lines":{"type":"number","minimum":0,"maximum":10},"line_spacing_rule":{"const":"exactly"},"line_spacing_pt":{"type":"number","minimum":8,"maximum":100},"page_break_before":{"type":"boolean"},"outline_level":{"type":"integer","minimum":1,"maximum":10}}}}}]},
    "setPageSetup":{"allOf":[{"$ref":"#/$defs/base"},{"properties":{"kind":{"const":"section.set_page_setup"},"required_capability":{"const":"section.page_setup"},"arguments":{"type":"object","additionalProperties":false,"required":["page_width_cm","page_height_cm","margin_top_cm","margin_bottom_cm","margin_left_cm","margin_right_cm","lines_per_page","chars_per_line","grid_alignment","grid_mode"],"properties":{"page_width_cm":{"type":"number","minimum":10,"maximum":60},"page_height_cm":{"type":"number","minimum":10,"maximum":60},"margin_top_cm":{"type":"number","minimum":0,"maximum":10},"margin_bottom_cm":{"type":"number","minimum":0,"maximum":10},"margin_left_cm":{"type":"number","minimum":0,"maximum":10},"margin_right_cm":{"type":"number","minimum":0,"maximum":10},"lines_per_page":{"type":"integer","minimum":1,"maximum":100},"chars_per_line":{"type":"integer","minimum":1,"maximum":200},"grid_alignment":{"const":"文字对齐字符网络"},"grid_mode":{"enum":["natural","line_only","strict_lines_and_chars"]}}}}}]}
  }
}
