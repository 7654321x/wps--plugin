{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docxtool.local/schemas/formatting-command-set.schema.json",
  "title": "FormattingCommandSet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "service_version", "commands", "warnings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9-]{16,64}$"},
    "service_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "commands": {"type": "array", "maxItems": 500000, "items": {"$ref": "#/$defs/command"}},
    "warnings": {"type": "array", "items": {"type": "string", "maxLength": 200}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "source_paragraph_index", "text_sha256"],
      "properties": {
        "target_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$"},
        "source_paragraph_index": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "text_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "kind", "target", "arguments", "required_capability", "on_unsupported"],
      "properties": {
        "command_id": {"type": "string", "pattern": "^cmd-[0-9]{6}$"},
        "kind": {"enum": ["paragraph.set_font", "paragraph.set_alignment", "paragraph.set_indent", "paragraph.set_spacing", "section.set_page_setup"]},
        "target": {"$ref": "#/$defs/target"},
        "arguments": {"type": "object", "additionalProperties": false, "properties": {
          "font_family": {"type": "string", "minLength": 1, "maxLength": 128},
          "font_size_pt": {"type": "number", "minimum": 5, "maximum": 72},
          "bold": {"type": "boolean"},
          "alignment": {"enum": ["left", "center", "right", "justify", "distributed"]},
          "first_line_indent_chars": {"type": "number", "minimum": 0, "maximum": 10},
          "left_indent_chars": {"type": "number", "minimum": 0, "maximum": 10},
          "right_indent_chars": {"type": "number", "minimum": 0, "maximum": 10},
          "line_spacing_pt": {"type": "number", "minimum": 8, "maximum": 100},
          "space_before_lines": {"type": "number", "minimum": 0, "maximum": 10},
          "space_after_lines": {"type": "number", "minimum": 0, "maximum": 10},
          "outline_level": {"type": "number", "minimum": 1, "maximum": 10},
          "page_width_cm": {"type": "number", "minimum": 10, "maximum": 60},
          "page_height_cm": {"type": "number", "minimum": 10, "maximum": 60},
          "margin_top_cm": {"type": "number", "minimum": 0, "maximum": 10},
          "margin_bottom_cm": {"type": "number", "minimum": 0, "maximum": 10},
          "margin_left_cm": {"type": "number", "minimum": 0, "maximum": 10},
          "margin_right_cm": {"type": "number", "minimum": 0, "maximum": 10}
          ,"lines_per_page": {"type": "number", "minimum": 1, "maximum": 100}
          ,"chars_per_line": {"type": "number", "minimum": 1, "maximum": 200}
          ,"grid_alignment": {"const": "文字对齐字符网络"}
          ,"grid_mode": {"enum": ["natural", "line_only", "strict_lines_and_chars"]}
        }},
        "required_capability": {"enum": ["paragraph.font", "paragraph.alignment", "paragraph.indent", "paragraph.spacing", "section.page_setup"]},
        "on_unsupported": {"enum": ["skip", "fail"]}
      }
    }
  }
}
