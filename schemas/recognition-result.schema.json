{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docxtool.local/schemas/recognition-result.schema.json",
  "title": "RecognitionResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "recognition_engine_version", "document_id", "document_revision", "source_sha256", "document_mode", "document_mode_confidence", "paragraphs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "recognition_engine_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "document_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "document_revision": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "document_mode": {"enum": ["unknown", "normal", "report", "notice", "plan", "meeting_minutes"]},
    "document_mode_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "paragraphs": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/paragraph"}},
    "review_items": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/review"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "source_paragraph_index", "recognized_type", "section_kind", "text_sha256", "text_length", "occurrence_index", "confidence", "review_level", "needs_review"],
      "properties": {
        "target_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$"},
        "source_paragraph_index": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "recognized_type": {"enum": ["main_title", "title_continuation", "dispatch_number", "recipient", "body", "heading1", "heading2", "heading3", "heading4", "key_value", "meeting_meta", "signature_org", "signature_date", "source_note", "embedded_document_title", "attachment_note", "attachment_title", "addressing", "date_line", "author_line", "role_name", "title2", "glossary_title", "glossary_item", "attachment_note_item", "attachment_page_mark", "attachment_body", "heading1_report", "list", "list_item", "quote", "annotation", "closing", "number", "letter", "page_number", "superscript", "caption", "unknown"]},
        "section_kind": {"enum": ["header", "dispatch_meta", "recipient", "body", "meeting_meta", "signature", "source_note", "embedded_document", "attachment_note", "attachment_body"]},
        "text_sha256": {"$ref": "#/$defs/sha256"},
        "text_length": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "occurrence_index": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "review_level": {"enum": ["confirmed", "info", "review", "critical_review"]},
        "needs_review": {"type": "boolean"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "level", "confidence"],
      "properties": {
        "target_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$"},
        "level": {"enum": ["review", "critical_review"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
